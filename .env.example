# 1. Database URL
# Leave as sqlite:///./mybca_transactions.db for local testing on your Mac.
# For Render / Koyeb cloud deployment, paste your Supabase PostgreSQL connection string (Transaction Pooler port 6543):
DATABASE_URL=sqlite:///./mybca_transactions.db

# 2. Google Gemini API Key (100% Free Tier - get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Telegram Bot Token (Create a free bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Restrict bot access to your personal Telegram numeric User ID (shown when you send /start)
ALLOWED_TELEGRAM_USER_IDS=

# 4. Gmail IMAP Auto-Sync (Required for cloud hosting; optional locally if using sync_from_gmail_cli.py)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_SYNC_INTERVAL_SECONDS=300

# 5. Default Foreign Exchange Rates to IDR (for PasporBCA overseas transactions before e-Statement reconciliation)
JPY_TO_IDR_RATE=105.5
USD_TO_IDR_RATE=15850.0
SGD_TO_IDR_RATE=11800.0
